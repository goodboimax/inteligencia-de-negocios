      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Limpiar SQL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022 CTP2.0; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3E550BEC-B1C8-4CF0-9FAB-F8739673DAD6}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.Fact_Detalle_Venta;&#xA;DELETE FROM dbo.Dim_Cliente;&#xA;DELETE FROM dbo.Dim_Producto;&#xA;DELETE FROM dbo.Dim_Empleado;&#xA;DELETE FROM dbo.Dim_Transportista;&#xA;&#xA;DECLARE @t SYSNAME;&#xA;DECLARE c CURSOR LOCAL FAST_FORWARD FOR&#xA;    SELECT QUOTENAME(OBJECT_SCHEMA_NAME(object_id)) + '.' + QUOTENAME(OBJECT_NAME(object_id))&#xA;    FROM sys.identity_columns&#xA;    WHERE object_id IN (OBJECT_ID('dbo.Dim_Cliente'), OBJECT_ID('dbo.Dim_Producto'),&#xA;                        OBJECT_ID('dbo.Dim_Empleado'), OBJECT_ID('dbo.Dim_Transportista'))&#xA;      AND last_value IS NOT NULL;&#xA;OPEN c;&#xA;FETCH NEXT FROM c INTO @t;&#xA;WHILE @@FETCH_STATUS = 0&#xA;BEGIN&#xA;    DBCC CHECKIDENT (@t, RESEED, 0) WITH NO_INFOMSGS;&#xA;    FETCH NEXT FROM c INTO @t;&#xA;END&#xA;CLOSE c;&#xA;DEALLOCATE c;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
