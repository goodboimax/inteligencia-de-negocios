              </xs:complexType>
            </xs:element>
            <xs:element name="Fact_Detalle_Venta" msprop:DbTableName="Fact_Detalle_Venta" msprop:FriendlyName="Fact_Detalle_Venta" msprop:TableType="Table" msprop:DbSchemaName="dbo">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="OrdenID" msprop:FriendlyName="OrdenID" msprop:DbColumnName="OrdenID" type="xs:int" />
                  <xs:element name="ProductoKey" msprop:FriendlyName="ProductoKey" msprop:DbColumnName="ProductoKey" type="xs:int" />
                  <xs:element name="FechaOrdenKey" msprop:FriendlyName="FechaOrdenKey" msprop:DbColumnName="FechaOrdenKey" type="xs:int" />
                  <xs:element name="FechaEnvioKey" msprop:FriendlyName="FechaEnvioKey" msprop:DbColumnName="FechaEnvioKey" type="xs:int" minOccurs="0" />
                  <xs:element name="ClienteKey" msprop:FriendlyName="ClienteKey" msprop:DbColumnName="ClienteKey" type="xs:int" />
                  <xs:element name="EmpleadoKey" msprop:FriendlyName="EmpleadoKey" msprop:DbColumnName="EmpleadoKey" type="xs:int" />
                  <xs:element name="TransportistaKey" msprop:FriendlyName="TransportistaKey" msprop:DbColumnName="TransportistaKey" type="xs:int" />
                  <xs:element name="Cantidad" msprop:FriendlyName="Cantidad" msprop:DbColumnName="Cantidad" type="xs:int" />
                  <xs:element name="PrecioUnitario" msprop:FriendlyName="PrecioUnitario" msprop:DbColumnName="PrecioUnitario" type="xs:decimal" />
                  <xs:element name="Descuento" msprop:FriendlyName="Descuento" msprop:DbColumnName="Descuento" type="xs:decimal" />
                  <xs:element name="MontoBruto" msprop:FriendlyName="MontoBruto" msprop:DbColumnName="MontoBruto" type="xs:decimal" />
                  <xs:element name="MontoDescuento" msprop:FriendlyName="MontoDescuento" msprop:DbColumnName="MontoDescuento" type="xs:decimal" />
                  <xs:element name="MontoNeto" msprop:FriendlyName="MontoNeto" msprop:DbColumnName="MontoNeto" type="xs:decimal" />
                  <xs:element name="DiasDespacho" msprop:FriendlyName="DiasDespacho" msprop:DbColumnName="DiasDespacho" type="xs:int" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="Fact_Orden" msprop:DbTableName="Fact_Orden" msprop:FriendlyName="Fact_Orden" msprop:TableType="View" msprop:QueryDefinition="SELECT OrdenID, MIN(FechaOrdenKey) AS FechaOrdenKey, MIN(FechaEnvioKey) AS FechaEnvioKey,&#xA;       MIN(ClienteKey) AS ClienteKey, MIN(EmpleadoKey) AS EmpleadoKey,&#xA;       MIN(TransportistaKey) AS TransportistaKey, MIN(DiasDespacho) AS DiasDespacho&#xA;FROM dbo.Fact_Detalle_Venta GROUP BY OrdenID">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="OrdenID" msprop:FriendlyName="OrdenID" msprop:DbColumnName="OrdenID" type="xs:int" />
                  <xs:element name="FechaOrdenKey" msdata:ReadOnly="true" msprop:FriendlyName="FechaOrdenKey" msprop:DbColumnName="FechaOrdenKey" type="xs:int" minOccurs="0" />
                  <xs:element name="FechaEnvioKey" msdata:ReadOnly="true" msprop:FriendlyName="FechaEnvioKey" msprop:DbColumnName="FechaEnvioKey" type="xs:int" minOccurs="0" />
                  <xs:element name="ClienteKey" msdata:ReadOnly="true" msprop:FriendlyName="ClienteKey" msprop:DbColumnName="ClienteKey" type="xs:int" minOccurs="0" />
                  <xs:element name="EmpleadoKey" msdata:ReadOnly="true" msprop:FriendlyName="EmpleadoKey" msprop:DbColumnName="EmpleadoKey" type="xs:int" minOccurs="0" />
                  <xs:element name="TransportistaKey" msdata:ReadOnly="true" msprop:FriendlyName="TransportistaKey" msprop:DbColumnName="TransportistaKey" type="xs:int" minOccurs="0" />
                  <xs:element name="DiasDespacho" msdata:ReadOnly="true" msprop:FriendlyName="DiasDespacho" msprop:DbColumnName="DiasDespacho" type="xs:int" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:choice>
        </xs:complexType>
        <xs:unique name="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//Dim_Tiempo" />
          <xs:field xpath="FechaKey" />
        </xs:unique>
        <xs:unique name="Dim_Cliente_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//Dim_Cliente" />
