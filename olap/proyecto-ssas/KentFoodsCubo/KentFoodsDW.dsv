          <xs:field xpath="OrdenID" />
          <xs:field xpath="ProductoKey" />
        </xs:unique>
        <xs:unique name="Fact_Orden_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//Fact_Orden" />
          <xs:field xpath="OrdenID" />
        </xs:unique>
        <xs:keyref name="FK_FactOrden_FechaOrden" refer="Constraint1" msprop:rel_IsLogical="True">
          <xs:selector xpath=".//Fact_Orden" />
          <xs:field xpath="FechaOrdenKey" />
        </xs:keyref>
        <xs:keyref name="FK_FactOrden_FechaEnvio" refer="Constraint1" msprop:rel_IsLogical="True">
          <xs:selector xpath=".//Fact_Orden" />
          <xs:field xpath="FechaEnvioKey" />
        </xs:keyref>
        <xs:keyref name="FK_FactOrden_Cliente" refer="Dim_Cliente_Constraint1" msprop:rel_IsLogical="True">
          <xs:selector xpath=".//Fact_Orden" />
          <xs:field xpath="ClienteKey" />
        </xs:keyref>
        <xs:keyref name="FK_FactOrden_Empleado" refer="Dim_Empleado_Constraint1" msprop:rel_IsLogical="True">
          <xs:selector xpath=".//Fact_Orden" />
          <xs:field xpath="EmpleadoKey" />
        </xs:keyref>
        <xs:keyref name="FK_FactOrden_Transportista" refer="Dim_Transportista_Constraint1" msprop:rel_IsLogical="True">
