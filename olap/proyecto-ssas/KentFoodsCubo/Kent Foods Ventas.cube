    <MdxScript dwd:design-time-name="2ca77419-24a5-4f55-b68c-5f36c07f5e6a">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2026-11-22T20:30:37.143333Z</CreatedTimestamp>
      <LastSchemaUpdate>2026-11-22T20:30:37.143333Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;</Text>
        </Command>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio] AS IIF([Measures].[Ordenes]=0, NULL, [Measures].[Monto Neto]/[Measures].[Ordenes]), FORMAT_STRING='#,##0.00', ASSOCIATED_MEASURE_GROUP='Ventas', VISIBLE=1;</Text>
        </Command>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Pct Descuento] AS IIF([Measures].[Monto Bruto]=0, NULL, [Measures].[Monto Descuento]/[Measures].[Monto Bruto]), FORMAT_STRING='0.00%', ASSOCIATED_MEASURE_GROUP='Ventas', VISIBLE=1;</Text>
        </Command>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Descuento Promedio Orden] AS IIF([Measures].[Ordenes]=0, NULL, [Measures].[Monto Descuento]/[Measures].[Ordenes]), ASSOCIATED_MEASURE_GROUP='Ventas', FORMAT_STRING='#,##0.00', VISIBLE=1;</Text>
        </Command>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Dias Promedio Despacho] AS IIF([Measures].[Ordenes Despachadas]=0, NULL, [Measures].[Dias Despacho Total]/[Measures].[Ordenes Despachadas]), FORMAT_STRING='#,##0.00', ASSOCIATED_MEASURE_GROUP='Despachos', VISIBLE=1;</Text>
        </Command>
      </Commands>
    </MdxScript>
