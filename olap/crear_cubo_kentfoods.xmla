            <MdxScripts>
              <MdxScript>
                <ID>MdxScript</ID>
                <Name>MdxScript</Name>
                <Commands>
                  <Command>
                    <Text>CALCULATE;
// Ticket promedio = ventas netas / ordenes (KPI 2)
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio] AS
    IIF([Measures].[Ordenes] = 0, NULL, [Measures].[Monto Neto] / [Measures].[Ordenes]),
    FORMAT_STRING = "#,##0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ventas';
// % de descuento = descuento / monto bruto (KPI 4)
CREATE MEMBER CURRENTCUBE.[Measures].[% Descuento] AS
    IIF([Measures].[Monto Bruto] = 0, NULL, [Measures].[Monto Descuento] / [Measures].[Monto Bruto]),
    FORMAT_STRING = "0.0%", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ventas';
// Dias promedio de despacho por orden (KPI 3); ver vw_Fact_Venta_Cubo
CREATE MEMBER CURRENTCUBE.[Measures].[Dias Promedio Despacho] AS
    IIF([Measures].[Ordenes Despachadas] = 0, NULL,
        [Measures].[Dias Despacho Ponderado] / [Measures].[Ordenes Despachadas]),
    FORMAT_STRING = "0.0", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ventas';
</Text>
                  </Command>
                </Commands>
              </MdxScript>
            </MdxScripts>
          </Cube>
        </Cubes>
